# Cache static assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images
/content/media/*
  Cache-Control: public, max-age=31536000, immutable

# Cache other static files
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.mp4
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Cache HTML with shorter duration
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

